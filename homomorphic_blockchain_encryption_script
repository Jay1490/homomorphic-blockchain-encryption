utxos = {}

def initialize_utxos(*wallet_amount_pairs):
    for pair in wallet_amount_pairs:
        wallet, amount = pair
        addr = wallet.get_address()
        utxos.setdefault(addr, []).append({
            "txid": "init_" + addr[:8],
            "vout": 0,
            "value": amount
        })

def get_balance(address):
    return sum(utxo['value'] for utxo in utxos.get(address, []))

def create_transaction(sender_wallet, receiver_address, amount):
    sender_address = sender_wallet.get_address()
    sender_utxos = utxos.get(sender_address, [])
    total = 0
    selected_utxos = []

    for utxo in sender_utxos:
        selected_utxos.append(utxo)
        total += utxo['value']
        if total >= amount:
            break

    if total < amount:
        print("Insufficient funds!")
        return None

    change = total - amount
    tx_inputs = []
    for utxo in selected_utxos:
        data_to_sign = f"{utxo['txid']}{utxo['vout']}{amount}{sender_address}{receiver_address}"
        signature = sender_wallet.sign_data(data_to_sign)
        tx_input = TxInput(utxo['txid'], utxo['vout'], signature, sender_address)
        tx_inputs.append(tx_input)

    tx_outputs = [TxOutput(amount, receiver_address)]
    if change > 0:
        tx_outputs.append(TxOutput(change, sender_address))

    new_tx = Transaction(tx_inputs, tx_outputs)

    for utxo in selected_utxos:
        utxos[sender_address].remove(utxo)

    for index, out in enumerate(new_tx.tx_outputs):
        utxos.setdefault(out.address, []).append({
            "txid": new_tx.txid,
            "vout": index,
            "value": out.value
        })

    return new_tx

