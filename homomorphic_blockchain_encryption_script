# ----------------------------
# Bitcoin-Like Structures
# ----------------------------

class TxInput:
    def __init__(self, txid, vout, signature, pubkey, sequence=0xffffffff):
        self.txid = txid
        self.vout = vout
        self.signature = signature
        self.pubkey = pubkey
        self.sequence = sequence

    def to_dict(self):
        return {
            "txid": self.txid,
            "vout": self.vout,
            "scriptSig": {
                "signature": self.signature,
                "pubKey": self.pubkey
            },
            "sequence": self.sequence
        }

class TxOutput:
    def __init__(self, value, address):
        self.value = value
        self.address = address

    def to_dict(self):
        return {
            "value": self.value,
            "scriptPubKey": {
                "addresses": [self.address]
            }
        }

class Transaction:
    def __init__(self, tx_inputs, tx_outputs, version=2, locktime=0):
        self.version = version
        self.locktime = locktime
        self.tx_inputs = tx_inputs
        self.tx_outputs = tx_outputs
        self.txid = self.calculate_txid()

    def calculate_txid(self):
        data_str = f"{self.version}{self.locktime}"
        for inp in self.tx_inputs:
            data_str += (inp.txid + str(inp.vout) + inp.signature + inp.pubkey + str(inp.sequence))
        for outp in self.tx_outputs:
            data_str += (str(outp.value) + outp.address)
        first_hash = hashlib.sha256(data_str.encode()).digest()
        second_hash = hashlib.sha256(first_hash).hexdigest()
        return second_hash

    def to_bitcoin_like_dict(self, block_height=None, block_time=None):
        return {
            "txid": self.txid,
            "hash": self.txid,
            "version": self.version,
            "size": len(self.tx_inputs) * 180 + len(self.tx_outputs) * 34 + 10,
            "locktime": self.locktime,
            "vin": [inp.to_dict() for inp in self.tx_inputs],
            "vout": [outp.to_dict() for outp in self.tx_outputs],
            "blockhash": None if block_height is None else f"some_block_hash_{block_height}",
            "confirmations": 1 if block_height is not None else 0,
            "time": block_time if block_time is not None else int(time.time()),
        }

class Wallet:
    def __init__(self):
        self.private_key = ecdsa.SigningKey.generate(curve=ecdsa.SECP256k1)
        self.public_key = self.private_key.get_verifying_key()

    def get_address(self):
        return self.public_key.to_string().hex()

    def sign_data(self, data: str):
        return self.private_key.sign(data.encode()).hex()

    @staticmethod
    def verify_signature(data: str, signature: str, public_key_hex: str):
        try:
            public_key_bytes = bytes.fromhex(public_key_hex)
            verifying_key = ecdsa.VerifyingKey.from_string(public_key_bytes, curve=ecdsa.SECP256k1)
            verifying_key.verify(bytes.fromhex(signature), data.encode())
            return True
        except ecdsa.BadSignatureError:
            return False

class Block:
    def __init__(self, index, previous_hash, timestamp, transactions, nonce, block_hash, miner):
        self.index = index
        self.previous_hash = previous_hash
        self.timestamp = timestamp
        self.transactions = transactions
        self.nonce = nonce
        self.hash = block_hash
        self.miner = miner

    def to_dict(self):
        return {
            "height": self.index,
            "hash": self.hash,
            "previousblockhash": self.previous_hash,
            "time": self.timestamp,
            "miner": self.miner,
            "nonce": self.nonce,
            "tx": [
                tx.to_bitcoin_like_dict(
                    block_height=self.index,
                    block_time=int(datetime.strptime(self.timestamp, "%Y-%m-%d %H:%M:%S").timestamp())
                ) for tx in self.transactions
            ]
        }

DIFFICULTY = 4

def calculate_hash(index, previous_hash, timestamp, transactions, miner, nonce):
    tx_str = "".join([tx.txid for tx in transactions])
    value = f"{index}{previous_hash}{timestamp}{tx_str}{miner}{nonce}"
    return hashlib.sha256(value.encode()).hexdigest()

def proof_of_work(index, previous_hash, timestamp, transactions, miners):
    nonce = 0
    while True:
        current_miner = random.choice(miners)
        block_hash = calculate_hash(index, previous_hash, timestamp, transactions, current_miner, nonce)
        if block_hash[:DIFFICULTY] == "0" * DIFFICULTY:
            return block_hash, nonce, current_miner
        nonce += 1

class Blockchain:
    def __init__(self, miners):
        self.chain = []
        self.mempool = []
        self.miners = miners
        self.create_genesis_block()

    def create_genesis_block(self):
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        genesis_input = TxInput("0"*64, 0, "Genesis Signature", "System", 0)
        genesis_output = TxOutput(0, "Genesis")
        genesis_tx = Transaction([genesis_input], [genesis_output])
        block_hash, nonce, miner = proof_of_work(0, "0", timestamp, [genesis_tx], self.miners)
        genesis_block = Block(0, "0", timestamp, [genesis_tx], nonce, block_hash, miner)
        self.chain.append(genesis_block)
        print("Genesis Block mined by:", miner)
        print("Hash:", block_hash)

    def add_transaction(self, transaction):
        self.mempool.append(transaction)

    def mine_block(self):
        if not self.mempool:
            print("No transactions to mine!")
            return
        previous_block = self.chain[-1]
        index = previous_block.index + 1
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        tx_to_mine = self.mempool[:]
        block_hash, nonce, miner = proof_of_work(index, previous_block.hash, timestamp, tx_to_mine, self.miners)
        new_block = Block(index, previous_block.hash, timestamp, tx_to_mine, nonce, block_hash, miner)
        self.chain.append(new_block)
        self.mempool = []
        print(f"Block #{index} mined by {miner}")
        print("Hash:", block_hash)

