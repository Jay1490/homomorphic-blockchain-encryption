                       paillier_encrypt(pub, (pub[0]-amt)%pub[0]))
        else:
            c_bob   = paillier_homomorphic_add(pub, c_bob,
                       paillier_encrypt(pub, (pub[0]-amt)%pub[0]))
        if r=="alice":
            c_alice = paillier_homomorphic_add(pub, c_alice,
                       paillier_encrypt(pub, amt))
        else:
            c_bob   = paillier_homomorphic_add(pub, c_bob,
                       paillier_encrypt(pub, amt))

        # auto-mine
        if len(chain.mempool)>=2:
            chain.mine_block()

        # show balances
        pA = paillier_decrypt(priv,pub,c_alice)
        pB = paillier_decrypt(priv,pub,c_bob)
        print(f"\nEncrypted cA now = {c_alice}\n          cB now = {c_bob}")
        print(f"Decrypted balances → Alice: {pA}, Bob: {pB}")

    # final mine & display
    if chain.mempool: chain.mine_block()
    print("\nFinal chain:")
    for blk in chain.chain:
        print(json.dumps(blk.to_dict(),indent=2))

