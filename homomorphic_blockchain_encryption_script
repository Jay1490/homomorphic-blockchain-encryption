import json
import hashlib
import time
import random
from datetime import datetime
import ecdsa
import math
from sympy import randprime

# ----------------------------
# Paillier Homomorphic Encryption
# ----------------------------
def lcm(a, b):
    return abs(a*b) // math.gcd(a, b)

def extended_gcd(a, b):
    if b == 0:
        return (a, 1, 0)
    g, y, x = extended_gcd(b, a % b)
    return (g, x, y - (a // b)*x)

def modinv(a, m):
    g, x, _ = extended_gcd(a, m)
    if g != 1:
        raise Exception("No modular inverse")
    return x % m

def generate_paillier_keypair(bits=128):
    p = randprime(2**(bits-1), 2**bits)
    q = randprime(2**(bits-1), 2**bits)
    n = p * q
    g = n + 1
    lam = lcm(p-1, q-1)
    mu  = modinv(lam, n)
    return (n, g), (lam, mu)

def paillier_encrypt(pub, m):
    n, g = pub
    nsq = n * n
    r = random.randrange(1, n)
    while math.gcd(r, n) != 1:
        r = random.randrange(1, n)
    return (pow(g, m, nsq) * pow(r, n, nsq)) % nsq

def paillier_decrypt(priv, pub, c):
    n, _ = pub
    lam, mu = priv
    nsq = n * n
    x = pow(c, lam, nsq) - 1
    return ((x // n) * mu) % n

def paillier_homomorphic_add(pub, c1, c2):
    n, _ = pub
    return (c1 * c2) % (n * n)

# ----------------------------
# Bitcoin-Like Transaction Structures
# ----------------------------
class TxInput:
    def __init__(self, txid, vout, signature, pubkey, sequence=0xffffffff):
        self.txid = txid
        self.vout = vout
        self.signature = signature
        self.pubkey = pubkey
        self.sequence = sequence
    def to_dict(self):
        return {
            "txid": self.txid,
            "vout": self.vout,
            "scriptSig": {"signature": self.signature, "pubKey": self.pubkey},
            "sequence": self.sequence
        }

class TxOutput:
    def __init__(self, value, address):
        self.value = value
        self.address = address
    def to_dict(self):
        return {"value": self.value, "scriptPubKey": {"addresses": [self.address]}}

class Transaction:
    def __init__(self, tx_inputs, tx_outputs, version=2, locktime=0):
        self.version = version
        self.locktime = locktime
        self.tx_inputs = tx_inputs
        self.tx_outputs = tx_outputs
        self.txid = self.calculate_txid()
    def calculate_txid(self):
        s = f"{self.version}{self.locktime}"
        for inp in self.tx_inputs:
            s += inp.txid + str(inp.vout) + inp.signature + inp.pubkey + str(inp.sequence)
        for out in self.tx_outputs:
            s += str(out.value) + out.address
        h1 = hashlib.sha256(s.encode()).digest()
        return hashlib.sha256(h1).hexdigest()

class Wallet:
    def __init__(self):
        self._priv = ecdsa.SigningKey.generate(curve=ecdsa.SECP256k1)
        self._pub  = self._priv.get_verifying_key()
    def get_address(self):
        return self._pub.to_string().hex()
    def sign_data(self, data: str):
        return self._priv.sign(data.encode()).hex()

class Block:
    def __init__(self, index, prev_hash, timestamp, transactions, nonce, block_hash, miner):
        self.index = index
        self.previous_hash = prev_hash
        self.timestamp = timestamp
        self.transactions = transactions
        self.nonce = nonce
        self.hash = block_hash
        self.miner = miner
    def to_dict(self):
        return {
            "height": self.index,
            "hash": self.hash,
            "previousblockhash": self.previous_hash,
            "time": self.timestamp,
            "miner": self.miner,
            "nonce": self.nonce
        }

# ----------------------------
# Proof-of-Work & Blockchain
# ----------------------------
DIFFICULTY = 4

def calculate_hash(index, prev, timestamp, txs, miner, nonce):
    tx_str = "".join(tx.txid for tx in txs)
    val = f"{index}{prev}{timestamp}{tx_str}{miner}{nonce}"
    return hashlib.sha256(val.encode()).hexdigest()

def proof_of_work(index, prev, timestamp, txs, miners):
    nonce = 0
    while True:
        miner = random.choice(miners)
        h = calculate_hash(index, prev, timestamp, txs, miner, nonce)
        if h.startswith("0" * DIFFICULTY):
            return h, nonce, miner
        nonce += 1

class Blockchain:
    def __init__(self, miners):
        self.chain = []
        self.mempool = []
        self.miners = miners
        self.create_genesis_block()
    def create_genesis_block(self):
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        inp = TxInput("0"*64, 0, "Genesis", "System", 0)
        out = TxOutput(0, "Genesis")
        tx = Transaction([inp], [out])
        h, nonce, miner = proof_of_work(0, "0", ts, [tx], self.miners)
        self.chain.append(Block(0, "0", ts, [tx], nonce, h, miner))
        print(f"Genesis Block mined by {miner}: {h}")
    def add_transaction(self, tx):
        self.mempool.append(tx)
    def mine_block(self):
        if not self.mempool:
            print("No transactions to mine!")
            return
        prev = self.chain[-1]
        idx = prev.index + 1
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        h, nonce, miner = proof_of_work(idx, prev.hash, ts, self.mempool, self.miners)
        block = Block(idx, prev.hash, ts, self.mempool[:], nonce, h, miner)
        self.chain.append(block)
        self.mempool.clear()
        print(f"Mined Block #{idx} by {miner}: {h}")

# ----------------------------
# UTXO & Transaction Logic
# ----------------------------
utxos = {}

def initialize_utxos(*wallet_amounts):
    for wallet, amt in wallet_amounts:
        addr = wallet.get_address()
        utxos.setdefault(addr, []).append({"txid": f"init_{addr[:8]}", "vout": 0, "value": amt})

def get_balance(addr):
    return sum(u["value"] for u in utxos.get(addr, []))

def create_transaction(sender, receiver_addr, amount):
    addr = sender.get_address()
    coins = utxos.get(addr, [])
    total = 0
    used = []
    for u in coins:
        used.append(u)
        total += u["value"]
        if total >= amount:
            break
    if total < amount:
        print("Insufficient funds!")
        return None
    change = total - amount
    inputs = []
    for u in used:
        data = f"{u['txid']}{u['vout']}{amount}{addr}{receiver_addr}"
        sig = sender.sign_data(data)
        inputs.append(TxInput(u["txid"], u["vout"], sig, addr))
    outputs = [TxOutput(amount, receiver_addr)]
    if change > 0:
        outputs.append(TxOutput(change, addr))
    tx = Transaction(inputs, outputs)
    # update UTXOs
    for u in used:
        utxos[addr].remove(u)
    for idx, o in enumerate(outputs):
        utxos.setdefault(o.address, []).append({"txid": tx.txid, "vout": idx, "value": o.value})
    return tx

# ----------------------------
# Interactive Demo
# ----------------------------
def interactive_demo():
    # Paillier keypair
    pub, priv = generate_paillier_keypair(128)
    try:
        a0 = int(input("Enter initial balance for Alice: "))
        b0 = int(input("Enter initial balance for Bob: "))
    except ValueError:
        a0 = b0 = 100
        print("Invalid input, defaulting to 100 each.")
    # encrypt initial balances
    cA = paillier_encrypt(pub, a0)
    cB = paillier_encrypt(pub, b0)
    # wallet & blockchain setup
    alice = Wallet()
    bob   = Wallet()
    initialize_utxos((alice, a0), (bob, b0))
    chain = Blockchain(["Miner1", "Miner2", "Miner3"]
)
    print(f"Plain balances: Alice={a0}, Bob={b0}")
    print(f"Encrypted: cA={cA}, cB={cB}\n")

    while True:
        print("\n--- New Transaction ---")
        sender_name = input("Sender (alice/bob or exit): ").strip().lower()
        if sender_name == "exit":
            break
        receiver_name = input("Receiver (alice/bob): ").strip().lower()
        try:
            amount = int(input("Amount: ").strip())
        except ValueError:
            print("Invalid amount. Try again.")
            continue
        if sender_name not in ("alice", "bob") or receiver_name not in ("alice", "bob"):
            print("Invalid names. Try again.")
            continue
        sender = alice if sender_name == "alice" else bob
        receiver = alice if receiver_name == "alice" else bob
        tx = create_transaction(sender, receiver.get_address(), amount)
        if not tx:
            continue
        chain.add_transaction(tx)
        print(f"Queued TX {tx.txid[:8]}: {sender_name}->{receiver_name} {amount}")
        # homomorphic update
        # subtract from sender
        c_sub = paillier_encrypt(pub, (pub[0] - amount) % pub[0])
        if sender_name == "alice":
            cA = paillier_homomorphic_add(pub, cA, c_sub)
        else:
            cB = paillier_homomorphic_add(pub, cB, c_sub)
        # add to receiver
        c_add = paillier_encrypt(pub, amount)
        if receiver_name == "alice":
            cA = paillier_homomorphic_add(pub, cA, c_add)
        else:
            cB = paillier_homomorphic_add(pub, cB, c_add)
        # auto-mine
        if len(chain.mempool) >= 2:
            chain.mine_block()
        # show decrypted balances
        pA = paillier_decrypt(priv, pub, cA)
        pB = paillier_decrypt(priv, pub, cB)
        print(f"Decrypted balances: Alice={pA}, Bob={pB}")

    # final mine
    if chain.mempool:
        chain.mine_block()

    # final print
    print("\nFinal Blockchain Encrypted-Only Outputs:")
    for blk in chain.chain:
        blk_d = blk.to_dict()
        txs = []
        for tx in blk.transactions:
            txd = {"txid": tx.txid, "vin": [inp.to_dict() for inp in tx.tx_inputs]}
            vouts = []
            for out in tx.tx_outputs:
                vouts.append({"encryptedValue": paillier_encrypt(pub, out.value),
                              "addresses": [out.address]})
            txd["vout"] = vouts
            txs.append(txd)
        blk_d["tx"] = txs
        print(json.dumps(blk_d, indent=2))

if __name__ == "__main__":
    interactive_demo()
