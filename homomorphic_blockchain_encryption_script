"""Generate Key Pair

Paillier encryption uses:

A public key (n, g)

A private key (λ, μ)
"""

import random
import math

def lcm(a, b):
    return abs(a * b) // math.gcd(a, b)

def modinv(a, m):
    """ Compute modular inverse of a under modulo m """
    g, x, y = extended_gcd(a, m)
    if g != 1:
        raise ValueError("No modular inverse exists")
    return x % m

def extended_gcd(a, b):
    """ Extended Euclidean Algorithm """
    if a == 0:
        return b, 0, 1
    g, x1, y1 = extended_gcd(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return g, x, y

def generate_keypair(bit_length=512):
    """ Generate Paillier key pair """
    # Step 1: Choose two large prime numbers p and q
    p = random.getrandbits(bit_length)
    q = random.getrandbits(bit_length)

    # Ensure p and q are prime
    while not is_prime(p):
        p = random.getrandbits(bit_length)
    while not is_prime(q) or p == q:
        q = random.getrandbits(bit_length)

    # Step 2: Compute n and λ
    n = p * q
    λ = lcm(p - 1, q - 1)

    # Step 3: Choose g and compute μ
    g = n + 1
    μ = modinv(λ, n)

    return ((n, g), (λ, μ))  # Public key (n, g), Private key (λ, μ)

def is_prime(n, k=5):
    """ Miller-Rabin primality test """
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0:
        return False

    r, d = 0, n - 1
    while d % 2 == 0:
        r += 1
        d //= 2

    for _ in range(k):
        a = random.randint(2, n - 2)
        x = pow(a, d, n)
        if x == 1 or x == n - 1:
            continue

        for _ in range(r - 1):
            x = pow(x, 2, n)
            if x == n - 1:
                break
        else:
            return False
    return True

