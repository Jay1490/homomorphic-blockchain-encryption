DIFFICULTY = 4
def calculate_hash(index, prev, ts, txs, miner, nonce):
    txs_str = "".join(tx.txid for tx in txs)
    return hashlib.sha256(f"{index}{prev}{ts}{txs_str}{miner}{nonce}".encode()).hexdigest()

def proof_of_work(index, prev, ts, txs, miners):
    nonce = 0
    while True:
        m = random.choice(miners)
        h = calculate_hash(index, prev, ts, txs, m, nonce)
        if h.startswith("0"*DIFFICULTY):
            return h, nonce, m
        nonce += 1

class Blockchain:
    def __init__(self, miners):
        self.chain = []; self.mempool = []; self.miners = miners
        self.create_genesis_block()
    def create_genesis_block(self):
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        inp = TxInput("0"*64,0,"Genesis","System",0)
        out= TxOutput(0,"Genesis")
        gt= Transaction([inp],[out])
        h, nonce, miner = proof_of_work(0,"0",ts,[gt],self.miners)
        self.chain.append(Block(0,"0",ts,[gt],nonce,h,miner))
        print("Genesis mined by",miner,":",h)
    def add_transaction(self,tx): self.mempool.append(tx)
    def mine_block(self):
        if not self.mempool:
            print("No tx to mine"); return
        prev = self.chain[-1]
        idx = prev.index+1
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        h,nonce,miner = proof_of_work(idx,prev.hash,ts,self.mempool,self.miners)
        blk = Block(idx, prev.hash, ts, self.mempool, nonce, h, miner)
        self.chain.append(blk)
        self.mempool=[]
        print(f"Mined #{idx} by {miner}:",h)

