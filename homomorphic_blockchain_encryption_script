    wallet_map = {"alice": alice, "bob": bob}

    initialize_utxos((alice, initial_alice), (bob, initial_bob))

    print("\nBlockchain initialized with wallets Alice and Bob.")
    print("Initial Balances:")
    for name, wallet in wallet_map.items():
        print(f"{name.title():<6}: {get_balance(wallet.get_address())}")

    miners = ["Miner1", "Miner2", "Miner3"]
    my_blockchain = Blockchain(miners)

    while True:
        print("\nNew Transaction")
        sender = input("Enter sender (alice/bob or 'exit' to quit): ").strip().lower()
        if sender == "exit":
