def encrypt(public_key, plaintext):
    """ Encrypts a message using Paillier encryption """
    n, g = public_key
    n_sq = n * n
    r = random.randint(1, n - 1)

    # Ensure r is coprime with n
    while math.gcd(r, n) != 1:
        r = random.randint(1, n - 1)

    # Encryption formula: c = (g^m * r^n) mod n^2
    ciphertext = (pow(g, plaintext, n_sq) * pow(r, n, n_sq)) % n_sq
    return ciphertext

"""![image.png](data:image/png;base64,)"""

def homomorphic_add(public_key, c1, c2):
    """ Adds two encrypted numbers homomorphically """
    n, _ = public_key
    n_sq = n * n
    return (c1 * c2) % n_sq

"""![image.png](data:image/png;base64,)"""

def L(x, n):
    return (x - 1) // n

def decrypt(private_key, public_key, ciphertext):
    """ Decrypts a Paillier-encrypted message """
    n, _ = public_key
    λ, μ = private_key
    n_sq = n * n

    # Compute L(c^λ mod n^2)
    x = pow(ciphertext, λ, n_sq)
    m = (L(x, n) * μ) % n
    return m

