class Transaction:
    def __init__(self, tx_inputs, tx_outputs, version=2, locktime=0):
        self.version = version; self.locktime = locktime
        self.tx_inputs = tx_inputs; self.tx_outputs = tx_outputs
        self.txid = self.calculate_txid()
    def calculate_txid(self):
        s = f"{self.version}{self.locktime}"
        for i in self.tx_inputs:
            s += i.txid + str(i.vout) + i.signature + i.pubkey + str(i.sequence)
        for o in self.tx_outputs:
            s += str(o.value) + o.address
        h1 = hashlib.sha256(s.encode()).digest()
        return hashlib.sha256(h1).hexdigest()
    def to_bitcoin_like_dict(self, block_height=None, block_time=None):
        return {
            "txid": self.txid, "hash": self.txid, "version": self.version,
            "size": len(self.tx_inputs)*180 + len(self.tx_outputs)*34 + 10,
            "locktime": self.locktime,
            "vin":  [i.to_dict() for i in self.tx_inputs],
            "vout": [o.to_dict() for o in self.tx_outputs],
            "blockhash": None if block_height is None else f"some_block_hash_{block_height}",
            "confirmations": 1 if block_height!=None else 0,
            "time": block_time if block_time else int(time.time())
