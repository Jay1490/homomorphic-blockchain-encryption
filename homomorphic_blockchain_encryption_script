utxos = {}

def initialize_utxos(*wallet_amounts):
    for w,amt in wallet_amounts:
        addr = w.get_address()
        utxos.setdefault(addr,[]).append({"txid":"init_"+addr[:8],"vout":0,"value":amt})

def get_balance(addr):
    return sum(u["value"] for u in utxos.get(addr,[]))

def create_transaction(sender, recv_addr, amt):
    saddr = sender.get_address()
    coins = utxos.get(saddr,[])
    total=0; used=[]
    for u in coins:
        used.append(u); total+=u["value"]
        if total>=amt: break
    if total<amt:
        print("Insufficient funds"); return None
    change= total-amt
    txi=[]
    for u in used:
        data=f"{u['txid']}{u['vout']}{amt}{saddr}{recv_addr}"
        sig= sender.sign_data(data)
        txi.append(TxInput(u["txid"],u["vout"],sig,saddr))
    txo=[TxOutput(amt,recv_addr)]
    if change>0: txo.append(TxOutput(change,saddr))
    tx=Transaction(txi,txo)
    for u in used: utxos[saddr].remove(u)
    for idx,o in enumerate(tx.tx_outputs):
        utxos.setdefault(o.address,[]).append({"txid":tx.txid,"vout":idx,"value":o.value})
    return tx

